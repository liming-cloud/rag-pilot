<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liming.rag.identity.infrastructure.persistence.AppUserRoleMapper">

    <!-- 一条语句插入多行，不用逐行插入。 -->
    <insert id="insertAll">
        INSERT INTO app_user_role (user_id, role_id) VALUES
        <foreach collection="roleIds" item="roleId" separator=",">(#{userId}, #{roleId})</foreach>
    </insert>
</mapper>
