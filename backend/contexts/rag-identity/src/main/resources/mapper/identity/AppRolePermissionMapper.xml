<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liming.rag.identity.infrastructure.persistence.AppRolePermissionMapper">

    <!-- 一条语句插入多行，不用逐行插入。 -->
    <insert id="insertAll">
        INSERT INTO app_role_permission (role_id, permission) VALUES
        <foreach collection="permissions" item="permission" separator=",">(#{roleId}, #{permission})</foreach>
    </insert>
</mapper>
