{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev:mock", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "api-verify",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DB_URL=jdbc:postgresql://127.0.0.1:55432/postgres",
        "DB_USERNAME=postgres",
        "DB_PASSWORD=verify-db",
        "RAG_ADMIN_USERNAME=admin",
        "RAG_ADMIN_PASSWORD=verify-admin-pass",
        "RAG_EMBEDDING_PROVIDER=hashing",
        "RAG_RERANK_PROVIDER=lexical",
        "RAG_CHAT_PROVIDER=extractive",
        "RAG_STORAGE_ROOT=/tmp/rag-m3-verify-files",
        "java",
        "-jar",
        "backend/boot/rag-app/target/rag-app.jar",
        "--server.port=8081"
      ],
      "port": 8081
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PROXY=http://127.0.0.1:8081",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    }
  ]
}
