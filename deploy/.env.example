# 复制为 .env 后修改（开发时在仓库的 deploy/ 下，客户现场在离线包解压后的目录里），说明见 README.md。
# .env 里有密码和密钥：不要提交到代码仓库，不要放进备份，权限设为只有运维账号可读（chmod 600 .env）。
DB_PASSWORD=change-me
# Redis 的密码（缓存和登录会话，D-053），用 openssl rand -hex 24 生成。Redis 不对外开放端口。
REDIS_PASSWORD=change-me
# 硅基流动的 API Key，嵌入、重排、对话共用；用其他 OpenAI 兼容服务时同时改 MODEL_BASE_URL。
MODEL_API_KEY=
MODEL_BASE_URL=https://api.siliconflow.cn/v1
# 第一次启动时创建的超级管理员（全系统只有一个）；之后修改这两项不会覆盖已有密码。
RAG_ADMIN_USERNAME=admin
RAG_ADMIN_PASSWORD=
# 超级管理员忘记密码时才设置：重启后密码重置为它并解锁；重置完删掉这一行再重启（D-038）。
RAG_ADMIN_RESET_PASSWORD=
# 加密模型服务商密钥的主密钥（D-043）：用 openssl rand -base64 32 生成一次后不要再改，改了要在模型管理里重新录入密钥。
# 不填时不能在管理端保存服务商密钥，仍可用 MODEL_API_KEY 和不需要密钥的服务商。
# 备份里不含主密钥（D-048）：请另外抄存在安全的地方，恢复到新服务器时要用同一个值。
RAG_MASTER_KEY=
# 数据问答调用客户系统工具时给令牌签名的私钥（D-058、D-059）：ES256 的 JWK（一行 JSON），生成方法见 README“七、主密钥”。
# 不填时不能调用工具，其他功能不受影响；备份里不含它。
RAG_TOOL_SIGNING_KEY=
# 行业包（D-045）：提示词角色、拒答话术、问答页文案、推荐问题、行业词表；默认 retail（新零售），名字不存在时启动失败。
RAG_INDUSTRY_PACK=retail
# 使用统计的“一天”、资料有效期的“今天”按哪个时区划分（D-045、D-046）。
RAG_STATS_ZONE=Asia/Shanghai
# 资料失效日期在多少天内算“即将到期”，管理端据此提醒（D-046）。
RAG_EXPIRY_WARNING_DAYS=30
# 每个账号的提问频率上限：最近 1 分钟、最近 24 小时最多问几个，超过时提示稍后再问（防止一个账号占满模型额度）。
RAG_ASK_LIMIT_PER_MINUTE=10
RAG_ASK_LIMIT_PER_DAY=300
# 登录页和顶栏显示的产品名称、名称下方的一句话、登录按钮下方的提示；不填时用默认值（D-042）。
# 管理员在“系统设置”里改过的以界面为准，这里只作默认值（D-045）。
# 新零售试点示例：RAG_BRAND_NAME=门店运营知识库
RAG_BRAND_NAME=
RAG_BRAND_TAGLINE=
RAG_BRAND_LOGIN_HINT=
# 员工访问页面的端口。
WEB_PORT=80
# app 只绑定本机的端口，运维用来看健康检查和版本（curl http://127.0.0.1:8080/actuator/info）。
APP_PORT=8080
# 备份存放的目录（D-048），默认是部署目录旁边的 backups/；建议放在单独的磁盘上。
RAG_BACKUP_DIR=
# 镜像从哪里拉（#138）：数据库、Redis 镜像，以及在本机构建 app、web 镜像用的 JRE、Nginx 基础镜像。默认从 Docker Hub 按摘要拉；
# 用镜像源或内网仓库时改成那里的地址，@sha256: 后面的摘要保持与 compose.yml 里的一致，保证拿到的是同一个镜像。
RAG_DB_IMAGE=
RAG_REDIS_IMAGE=
RAG_JRE_IMAGE=
RAG_NGINX_IMAGE=
