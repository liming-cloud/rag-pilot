# 复制为 deploy/.env 后修改。deploy/.env 已被 Git 忽略，不要提交。
DB_PASSWORD=change-me
# 硅基流动的 API Key，嵌入、重排、对话共用。没有密钥时可以在 app 服务里设置 RAG_EMBEDDING_PROVIDER=hashing 离线试用。
MODEL_API_KEY=
# 第一次启动时创建的超级管理员（全系统只有一个）；之后修改这两项不会覆盖已有密码。
RAG_ADMIN_USERNAME=admin
RAG_ADMIN_PASSWORD=
# 超级管理员忘记密码时才设置：重启后密码重置为它并解锁；重置完删掉这一行再重启（D-038）。
RAG_ADMIN_RESET_PASSWORD=
# 员工访问页面的端口。
WEB_PORT=80
